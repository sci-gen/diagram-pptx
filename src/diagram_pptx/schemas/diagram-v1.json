{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sci-gen/diagram-pptx/schemas/diagram-v1.json",
  "title": "diagram-pptx semantic model",
  "type": "object",
  "required": ["schema_version", "kind"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": {
      "enum": ["flowchart", "sequence", "class", "er", "state"]
    },
    "direction": { "enum": ["LR", "RL", "TB", "BT", "TD"] },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "participants": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "classes": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "entities": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "states": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship" }
    },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "autonumber": { "type": "boolean" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true,
  "$defs": {
    "style": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "element": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "role": { "type": "string" },
        "classes": { "type": "array", "items": { "type": "string" } },
        "style": { "$ref": "#/$defs/style" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": true
    },
    "relationship": {
      "allOf": [
        { "$ref": "#/$defs/element" },
        {
          "type": "object",
          "required": ["source", "target"],
          "properties": {
            "source": { "type": "string" },
            "target": { "type": "string" }
          }
        }
      ]
    }
  }
}
