{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sci-gen/diagram-pptx/evals/schemas/judgment-v1.schema.json",
  "title": "diagram-pptx LLM judgment v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "case_id",
        "run_id",
        "judge",
        "scores",
        "verdict",
        "hard_failures",
        "rationale",
        "recommendations"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "score"},
        "case_id": {"type": "string"},
        "run_id": {"type": "string"},
        "judge": {"$ref": "#/$defs/judge"},
        "scores": {"$ref": "#/$defs/scores"},
        "verdict": {"enum": ["pass", "fail"]},
        "hard_failures": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/hardFailure"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "rationale": {"type": "string"},
        "recommendations": {"type": "array", "items": {"type": "string"}}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "case_id",
        "run_a",
        "run_b",
        "presentation_order",
        "winner",
        "judge",
        "rationale"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "pairwise"},
        "case_id": {"type": "string"},
        "run_a": {"type": "string"},
        "run_b": {"type": "string"},
        "presentation_order": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "string"}
        },
        "winner": {"enum": ["A", "B", "tie"]},
        "judge": {"$ref": "#/$defs/judge"},
        "rationale": {"type": "string"}
      }
    }
  ],
  "$defs": {
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "prompt_version", "trial"],
      "properties": {
        "provider": {"type": "string"},
        "model": {"type": "string"},
        "prompt_version": {"type": "string"},
        "trial": {"type": "integer", "minimum": 1}
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_fidelity",
        "slide_readability",
        "visual_balance",
        "information_granularity",
        "structural_cohesion",
        "split_quality"
      ],
      "properties": {
        "requirement_fidelity": {"type": "integer", "minimum": 1, "maximum": 5},
        "slide_readability": {"type": "integer", "minimum": 1, "maximum": 5},
        "visual_balance": {"type": "integer", "minimum": 1, "maximum": 5},
        "information_granularity": {"type": "integer", "minimum": 1, "maximum": 5},
        "structural_cohesion": {"type": "integer", "minimum": 1, "maximum": 5},
        "split_quality": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "hardFailure": {
      "enum": [
        "invalid_or_missing_render",
        "missing_required_content",
        "unreadable_text",
        "overlap_or_clipping",
        "extreme_aspect_ratio",
        "excessive_detail",
        "incoherent_split",
        "unauthorized_source_change"
      ]
    }
  }
}
